{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|sw\\.js|workbox-.*\\.js|registerSW\\.js|manifest\\.webmanifest|icon\\.svg|maskable-icon\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "content": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
